# Supabase Environment Variables
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional raster map tile template. Defaults to OpenStreetMap standard tiles.
# Set attribution text and URL to match any replacement tile provider.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=© OpenStreetMap contributors
NEXT_PUBLIC_MAP_ATTRIBUTION_URL=https://www.openstreetmap.org/copyright

# Optional: used for address search (Mapbox geocoding). The basemap and pickup
# routing work without it — routing uses the free OSRM service, no API key.
NEXT_PUBLIC_MAPBOX_TOKEN=your_public_mapbox_token_here
