# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API). Both values are safe to expose in the browser: the
# anon key only grants what the row level security policies allow.
#
# Never put the service_role key in a NEXT_PUBLIC_ variable. It bypasses row
# level security and must stay on a server you control.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
